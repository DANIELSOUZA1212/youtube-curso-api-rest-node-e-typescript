{
  "compilerOptions": {
    "target": "ES2020",                // Versão do JS para output
    "module": "CommonJS",              // Sistema de módulos para Node.js
    "rootDir": "./src",                // Pasta raiz do código fonte
    "outDir": "./dist",                // Pasta para os arquivos compilados
    "strict": true,                   // Ativa verificações rigorosas de tipo
    "esModuleInterop": true,          // Permite import compatível com módulos CommonJS
    "skipLibCheck": true,             // Pula checagem de tipos das libs para acelerar build
    "forceConsistentCasingInFileNames": true, // Consistência em importações maiúsc/minúsculas
    "resolveJsonModule": true,        // Permite importar arquivos JSON
    "noImplicitAny": true,            // Não permite any implícito
    "moduleResolution": "node",       // Resolve módulos como o Node
    "sourceMap": true,                // Gera source maps para debugging
    "removeComments": true,           // Remove comentários no JS gerado
    "types": ["node"],                // Inclui definições de tipos para Node
    "lib": ["ES2020"]                 // Biblioteca padrão ECMAScript
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
